CONFIG_IDF_TARGET="esp32s3"

# Console su UART0 (XIAO: D6 = TX/GPIO43, D7 = RX/GPIO44). La porta USB nativa serve da host.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# La console secondaria USB-Serial-JTAG, attiva di default, confligge con l'host USB.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# Con la coda attiva, se la lettura delle funzioni del client fallisce (0x1A con il Bluetooth Intel di
# Windows) NimBLE scarta le richieste ATT arrivate prima di CONNECT: la scoperta dei servizi resta appesa.
CONFIG_BT_NIMBLE_DEFER_CONN_EVENTS_UNTIL_CONNECT=n
# A livello info NimBLE scrive una riga per ogni notifica: con la console su UART a 115200 rallenta il bridge
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Device Information Service: Firmware Revision (PROJECT_VER) e Model Number (sempre presente)
CONFIG_BT_NIMBLE_DIS_SERVICE=y
CONFIG_BT_NIMBLE_SVC_DIS_FIRMWARE_REVISION=y
CONFIG_BT_NIMBLE_SVC_DIS_IEEE=n
CONFIG_BT_NIMBLE_SVC_DIS_UDI=n

# XIAO ESP32-S3: 8 MB di flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
